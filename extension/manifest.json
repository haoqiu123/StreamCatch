{
  "manifest_version": 3,
  "name": "StreamCatch · 视频下载助手",
  "version": "1.4.2",
  "description": "发现网页视频，下载 MP4、WebM、HLS；可选本地助手支持 DASH、音画合并和更多网站。",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "webRequest",
    "webNavigation",
    "nativeMessaging"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "StreamCatch 视频下载助手",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "core/x-media.js",
        "core/page-media.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": true
    }
  ],
  "options_page": "help.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "key": ""
}
